<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Notes</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <h1>My Notes</h1>
  <a href="/notes/new">+ Add New Note</a>
  <hr>

  <% if (notes.length === 0) { %>
    <p>No notes yet. Add one!</p>
  <% } else { %>
    <% notes.forEach(note => { %>
      <div class="note">
        <h3><%= note.title %></h3>
        <p><%= note.content %></p>
        <small>Category: <%= note.category || "General" %></small><br>
        <small>Created: <%= note.createdAt ? new Date(note.createdAt).toLocaleString() : "N/A" %></small>
        <form action="/notes/<%= note._id %>/delete" method="POST" style="margin-top:5px;">
          <button type="submit">Delete</button>
        </form>
      </div>
    <% }) %>
  <% } %>

  <hr>
  <footer>
    <p>GAURAVBHASKAR_590012457</p>
  </footer>

</body>
</html>