<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Add Note</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <h1>Add a New Note</h1>
  <a href="/">Back to Notes</a>
  <hr>

  <% if (typeof error !== "undefined" && error) { %>
    <p style="color: red;"><%= error %></p>
  <% } %>

  <form action="/notes" method="POST">
    <label>Title:</label><br>
    <input type="text" name="title" value="<%= typeof title !== 'undefined' ? title : '' %>" required><br><br>

    <label>Content:</label><br>
    <textarea name="content" rows="5" required><%= typeof content !== 'undefined' ? content : '' %></textarea><br><br>

    <label>Category:</label><br>
    <input type="text" name="category" value="<%= typeof category !== 'undefined' ? category : '' %>" placeholder="e.g. Study, Work"><br><br>

    <button type="submit">Add Note</button>
  </form>

  <hr>
  <footer>
    <p>GAURAVBHASKAR_590012457</p>
  </footer>

</body>
</html>